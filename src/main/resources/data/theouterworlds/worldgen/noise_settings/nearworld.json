{
	"default_block": "minecraft:basalt",
	"default_fluid": "minecraft:air",
	"disable_mob_generation": true,
	"legacy_random_source": false,
	"noise": {
		"height": 384,
		"min_y": -64,
		"size_horizontal": 1,
		"size_vertical": 2
	},
	"noise_router": {
		"temperature": {
			"type": "minecraft:noise",
			"noise": "minecraft:temperature",
			"shift_x": 0.0,
			"shift_z": 0.0,
			"xz_scale": 0.25,
			"y_scale": 0.0
		},
		"vegetation": 0,
		"continents": 0,
		"erosion": 0,
		"depth": "theouterworlds:nearworld/depth",
		"ridges": 0,
		"chunk_surface_level": {
			"type": "minecraft:interpolated",
			"cell_size_xz": 16,
			"cell_size_y": 1,
			"input": "theouterworlds:nearworld/surface_height"
		},
		"final_density": "theouterworlds:nearworld/final_density"
	},
	"sea_level": -64,
	"spawn_target": [
		{
			"theouterworlds:nearworld/depth": 0
		}
	],
	"material_rule": {
		"type": "minecraft:sequence",
		"sequence": [
			{
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:vertical_gradient",
					"false_at_and_above": {
						"above_bottom": 5
					},
					"random_name": "minecraft:bedrock_floor",
					"true_at_and_below": {
						"above_bottom": 0
					}
				},
				"then_run": {
					"type": "minecraft:block",
					"result_state": "minecraft:bedrock"
				}
			},
			{
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:biome",
					"biome_is": [
						"theouterworlds:nearworld_sulfur_caves"
					]
				},
				"then_run": {
					"type": "minecraft:sequence",
					"sequence": [
						{
							"type": "minecraft:condition",
							"if_true": {
								"type": "minecraft:noise_threshold",
								"is_3d": true,
								"max_threshold": -0.1,
								"min_threshold": -0.4,
								"noise": "minecraft:sulfur_cave_gradient"
							},
							"then_run": {
								"type": "minecraft:block",
								"result_state": "minecraft:cinnabar"
							}
						},
						{
							"type": "minecraft:condition",
							"if_true": {
								"type": "minecraft:noise_threshold",
								"is_3d": true,
								"max_threshold": 0.4,
								"min_threshold": 0.0,
								"noise": "minecraft:sulfur_cave_gradient"
							},
							"then_run": {
								"type": "minecraft:block",
								"result_state": "minecraft:sulfur"
							}
						},
						{
							"type": "minecraft:block",
							"result_state": "minecraft:cinnabar"
						}
					]
				}
			},
			{
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:stone_depth",
					"offset": 4,
					"surface_type": "floor",
					"add_surface_depth": true,
					"secondary_depth_range": 2
				},
				"then_run": {
					"type": "minecraft:block",
					"result_state": "theouterworlds:sulfuric_basalt"
				}
			},
			{
				"type": "minecraft:block",
				"result_state": "minecraft:basalt"
			}
		]
	}
}
