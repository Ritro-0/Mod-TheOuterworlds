{
	"default_block": "theouterworlds:carbonic_ice",
	"default_fluid": "minecraft:water",
	"disable_mob_generation": true,
	"legacy_random_source": false,
	"noise": {
		"height": 384,
		"min_y": -64,
		"size_horizontal": 1,
		"size_vertical": 2
	},
	"noise_router": {
		"temperature": 0,
		"vegetation": 0,
		"continents": 0,
		"erosion": 0,
		"depth": 0,
		"ridges": 0,
		"chunk_surface_level": {
			"type": "minecraft:interpolated",
			"cell_size_xz": 16,
			"cell_size_y": 1,
			"input": "theouterworlds:frostworld/surface_height"
		},
		"final_density": "theouterworlds:frostworld/final_density"
	},
	"sea_level": 91,
	"spawn_target": [],
	"material_rule": {
		"type": "minecraft:sequence",
		"sequence": [
			{
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:vertical_gradient",
					"false_at_and_above": {
						"above_bottom": 5
					},
					"random_name": "minecraft:bedrock_floor",
					"true_at_and_below": {
						"above_bottom": 0
					}
				},
				"then_run": {
					"type": "minecraft:block",
					"result_state": "minecraft:bedrock"
				}
			},
			{
				"type": "minecraft:condition",
				"if_true": {
					"type": "minecraft:noise_threshold",
					"is_3d": true,
					"max_threshold": 0.05,
					"min_threshold": -1.0,
					"noise": "minecraft:surface"
				},
				"then_run": {
					"type": "minecraft:block",
					"result_state": "theouterworlds:dry_ice"
				}
			},
			{
				"type": "minecraft:block",
				"result_state": "theouterworlds:carbonic_ice"
			}
		]
	}
}
